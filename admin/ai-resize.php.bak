<?php

namespace ProMediaCropper;

use Symfony\Component\HttpClient\HttpClient;
use Symfony\Component\HttpClient\Psr18Client;

/**
 * AJAX handler for AI resize via OpenAI
 * Expects: image (base64 JPG), nonce
 * Returns: JSON { success, data: { b64: '...', url: '...' } }
 */
add_action('wp_ajax_pmc_ai_resize', function () {
    check_ajax_referer('wp_rest', 'nonce');

    if (!current_user_can('publish_posts')) {
        wp_send_json_error('Unauthorized', 403);
    }

    $api_key  = get_option('pmc_openai_api_key') ?? '';

    if (empty($api_key)) {
        wp_send_json_error('OpenAI API key not configured in settings.');
    }

    $image_data = $_POST['image'] ?? '';
    $prompt   = sanitize_text_field($_POST['prompt'] ?? '');

    error_log('Sending OpenAi Request');
    error_log($prompt);

    if (empty($image_data)) {
        wp_send_json_error('No image data received.');
    }

    // Decode base64 PNG from JS canvas.toDataURL()
    $image_data = preg_replace('/^data:image\/\w+;base64,/', '', $image_data);
    $image_bin  = base64_decode($image_data);
    if ($image_bin === false) {
        wp_send_json_error('Invalid image data.');
    }

    // Write to a temp file — OpenAI PHP client needs a file path
    $tmp = wp_tempnam('pmc-ai-') . '.jpg';
    file_put_contents($tmp, $image_bin);

    try {
        set_time_limit(120);

        // Create the Symfony client with a higher timeout for AI processing
        $symfonyClient = HttpClient::create(['timeout' => 120]);
        $psr18Client = new Psr18Client($symfonyClient);

        // Pass the PSR-18 client to the OpenAI factory
        $client = \OpenAI::factory()
            ->withApiKey($api_key)
            ->withHttpClient($psr18Client)
            ->make();

        error_log('Sending request');
        $response = $client->images()->edit([
            'model'  => 'gpt-image-2',
            'image'  => fopen($tmp, 'r'),
            'prompt' => $prompt,
            'size'   => "auto"
        ]);

        // Log successful response metadata
        $meta = $response->meta();
        error_log(print_r($meta, true));

        // Log image info (checking if URL or B64 was returned)
        if (isset($response->data[0])) {
            $img = $response->data[0];
            if (isset($img->url)) error_log("Image URL: " . $img->url);
            if (isset($img->b64_json)) error_log("B64 Data Received: " . strlen($img->b64_json) . " bytes");
        }

        $b64 = $response->data[0]->b64_json ?? null;
        if (!$b64) {
            error_log('No image returned from OpenAI.');
            wp_send_json_error('No image returned from OpenAI.');
        }
        $finfo = finfo_open(FILEINFO_MIME_TYPE);
        $mime  = finfo_buffer($finfo, $image_bin);

        if (!in_array($mime, ['image/png', 'image/jpeg', 'image/webp'])) {
            error_log('Unsupported image format: ' . $mime);
            wp_send_json_error('Unsupported image format.');
        }

        error_log('Success!');
        wp_send_json_success(['b64' => $b64]);

    } catch (\Exception $e) {
        error_log('OpenAI error: ' . $e->getMessage());
        wp_send_json_error('OpenAI error: ' . $e->getMessage());
    } finally {
        error_log('Cleaning temp file: ' . $tmp);
        if (file_exists($tmp)) unlink($tmp);
    }
});